# CMake writes text files with native CRLF on Windows; notices must use LF.
function(write_lf path content)
  file(WRITE "${path}" "${content}")
  if(WIN32)
    set(ENV{LCARS_NOTICES_OUTPUT} "${path}")
    execute_process(COMMAND powershell -NoProfile -NonInteractive -Command
      "$p=$env:LCARS_NOTICES_OUTPUT; $s=[IO.File]::ReadAllText($p).Replace([string][char]13+[char]10,[string][char]10); [IO.File]::WriteAllText($p,$s,[Text.UTF8Encoding]::new($false))"
      COMMAND_ERROR_IS_FATAL ANY)
  endif()
endfunction()
if(MODE STREQUAL "update")
  write_lf("${ROOT}/THIRD_PARTY_NOTICES.txt" "${notice}")
elseif(MODE STREQUAL "check")
  write_lf("${OUT}/THIRD_PARTY_NOTICES.generated.txt" "${notice}")
  if(EXISTS "${ROOT}/THIRD_PARTY_NOTICES.txt")
    file(READ "${ROOT}/THIRD_PARTY_NOTICES.txt" existing)
    string(REPLACE "\r\n" "\n" existing "${existing}")
  else()
    set(existing "")
  endif()
  if(NOT existing STREQUAL notice)
    message(FATAL_ERROR "Notices are out of date. Run: cmake --build ${OUT} --target update_third_party_notices")
  endif()
else()
  message(FATAL_ERROR "MODE must be update or check")
endif()

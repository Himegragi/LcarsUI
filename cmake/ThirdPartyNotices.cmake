cmake_minimum_required(VERSION 3.25)
include("${ROOT}/cmake/ThirdPartyManifest.cmake")
verify_third_party("${ROOT}")
file(READ "${ROOT}/third_party/SOURCES.md" sources)
foreach(name freetype harfbuzz glcorearb khrplatform)
  foreach(field COMMIT SHA256)
    string(FIND "${sources}" "${${name}_${field}}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "third_party/SOURCES.md missing ${name} ${field}")
    endif()
  endforeach()
endforeach()
set(dir "${OUT}/notices-src")
file(MAKE_DIRECTORY "${dir}")
foreach(name freetype harfbuzz)
  set(files ${${name}_LICENSE_FILES})
  set(paths "")
  foreach(file IN LISTS files)
    list(APPEND paths "${name}-${${name}_COMMIT}/${file}")
  endforeach()
  file(ARCHIVE_EXTRACT INPUT "${ROOT}/third_party/${name}.tar.gz" DESTINATION "${dir}" PATTERNS ${paths})
endforeach()
set(notice "LcarsUI third-party notices\nThe LcarsUI::Desktop component statically includes the software listed below.\nThis file is generated by the update_third_party_notices build target; do not edit it by hand.\n")
macro(section title)
  string(APPEND notice "\n========================================================================\n${title}\n")
endmacro()
macro(append_file label path comment_only)
  file(READ "${path}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  if(${comment_only})
    string(REGEX MATCH "/\\*([^*]|\\*+[^*/])*\\*+/" content "${content}")
    if(content STREQUAL "")
      message(FATAL_ERROR "Missing license comment in ${path}")
    endif()
  endif()
  string(APPEND notice "------------------------------------------------------------------------ ${label}\n${content}\n")
endmacro()
section("FreeType ${freetype_VERSION}")
string(APPEND notice "License: FreeType License (FTL), chosen from the FTL / GPLv2 dual license\nSource: ${freetype_URL}\nCommit: ${freetype_COMMIT}\nSHA256: ${freetype_SHA256}\nCredit: Portions of this software are copyright (c) ${freetype_CREDIT_YEAR} The FreeType Project (www.freetype.org). All rights reserved.\n")
foreach(path docs/FTL.TXT src/bdf/README src/pcf/README)
  append_file("${path}" "${dir}/freetype-${freetype_COMMIT}/${path}" FALSE)
endforeach()
append_file("src/gzip/zlib.h (license comment)" "${dir}/freetype-${freetype_COMMIT}/src/gzip/zlib.h" TRUE)
section("HarfBuzz ${harfbuzz_VERSION}")
string(APPEND notice "License: Old MIT (COPYING); Microsoft MIT for src/ms-use\nSource: ${harfbuzz_URL}\nCommit: ${harfbuzz_COMMIT}\nSHA256: ${harfbuzz_SHA256}\n")
foreach(path COPYING src/ms-use/COPYING)
  append_file("${path}" "${dir}/harfbuzz-${harfbuzz_COMMIT}/${path}" FALSE)
endforeach()
section("Khronos OpenGL headers")
string(APPEND notice "License: MIT (glcorearb.h); khrplatform.h license\n")
foreach(name glcorearb khrplatform)
  if(name STREQUAL "glcorearb")
    set(path glcorearb.h)
  else()
    set(path KHR/khrplatform.h)
  endif()
  string(APPEND notice "Source: ${${name}_URL}\nCommit: ${${name}_COMMIT}\nSHA256: ${${name}_SHA256}\n")
  append_file("${path}" "${ROOT}/third_party/${path}" TRUE)
  if(name STREQUAL "glcorearb")

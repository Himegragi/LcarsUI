@PACKAGE_INIT@
set(LcarsUI_MSVC_RUNTIME_LIBRARY "@CMAKE_MSVC_RUNTIME_LIBRARY@")
set(LcarsUI_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(LcarsUI_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(LcarsUI_THIRD_PARTY_NOTICES_FILE "${PACKAGE_PREFIX_DIR}/share/doc/LcarsUI/THIRD_PARTY_NOTICES.txt")
set(LcarsUI_LICENSE_FILE "${PACKAGE_PREFIX_DIR}/share/doc/LcarsUI/LICENSE")
if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(LcarsUI_FOUND FALSE)
  set(LcarsUI_NOT_FOUND_MESSAGE "LcarsUI requires Windows x64 and an MSVC ABI compiler")
  return()
endif()
if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL LcarsUI_MSVC_RUNTIME_LIBRARY)
  set(LcarsUI_FOUND FALSE)
  set(LcarsUI_NOT_FOUND_MESSAGE "MSVC runtime mismatch: consumer ${CMAKE_MSVC_RUNTIME_LIBRARY}, LcarsUI ${LcarsUI_MSVC_RUNTIME_LIBRARY}; rebuild LcarsUI with the same setting")
  return()
endif()
get_property(_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(NOT _multi AND NOT CMAKE_BUILD_TYPE)
  set(LcarsUI_FOUND FALSE)
  set(LcarsUI_NOT_FOUND_MESSAGE "Please specify -DCMAKE_BUILD_TYPE=Debug or Release")
  return()
endif()
if(NOT LcarsUI_FIND_COMPONENTS)
  set(LcarsUI_FIND_COMPONENTS Core)
endif()
set(_available Core AppearanceWeb AppearanceMaterial Desktop Diagnostics)
foreach(_component IN LISTS LcarsUI_FIND_COMPONENTS)
  if(NOT _component IN_LIST _available)
    set(LcarsUI_${_component}_FOUND FALSE)
    set(LcarsUI_NOT_FOUND_MESSAGE "Unknown LcarsUI component ${_component}; available: ${_available}")
  elseif(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/LcarsUI${_component}Targets.cmake")
    set(LcarsUI_${_component}_FOUND FALSE)
    set(LcarsUI_NOT_FOUND_MESSAGE "LcarsUI was built with LCARS_BUILD_DESKTOP=OFF; ${_component} is unavailable")
  else()
    if(NOT TARGET LcarsUI::Core)
      include("${CMAKE_CURRENT_LIST_DIR}/LcarsUICoreTargets.cmake")
    endif()
    if(NOT TARGET LcarsUI::${_component})
      include("${CMAKE_CURRENT_LIST_DIR}/LcarsUI${_component}Targets.cmake")
    endif()
    set(LcarsUI_${_component}_FOUND TRUE)
    set_target_properties(LcarsUI::${_component} PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release MAP_IMPORTED_CONFIG_MINSIZEREL Release)
  endif()
endforeach()
if(TARGET LcarsUI::Desktop)
  foreach(_internal internal_render internal_freetype internal_harfbuzz)
    set_target_properties(LcarsUI::${_internal} PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release MAP_IMPORTED_CONFIG_MINSIZEREL Release)
  endforeach()
endif()
if(TARGET LcarsUI::Core)
  set_target_properties(LcarsUI::Core PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release MAP_IMPORTED_CONFIG_MINSIZEREL Release)
endif()
check_required_components(LcarsUI)
if(LcarsUI_FOUND)
  message(STATUS "Found LcarsUI ${LcarsUI_VERSION} from ${CMAKE_CURRENT_LIST_DIR}")
endif()

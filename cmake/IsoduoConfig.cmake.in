@PACKAGE_INIT@
set(Isoduo_MSVC_RUNTIME_LIBRARY "@CMAKE_MSVC_RUNTIME_LIBRARY@")
set(Isoduo_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(Isoduo_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(Isoduo_MSVC_TOOLSET_VERSION "@ISODUO_PACKAGE_MSVC_TOOLSET_VERSION@")
set(Isoduo_THIRD_PARTY_NOTICES_FILE "${PACKAGE_PREFIX_DIR}/share/doc/Isoduo/THIRD_PARTY_NOTICES.txt")
set(Isoduo_LICENSE_FILE "${PACKAGE_PREFIX_DIR}/share/doc/Isoduo/LICENSE")
if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@")
  set(Isoduo_FOUND FALSE)
  set(Isoduo_NOT_FOUND_MESSAGE "Isoduo was built for @CMAKE_SYSTEM_NAME@")
  return()
endif()
if(WIN32)
  if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(Isoduo_FOUND FALSE)
    set(Isoduo_NOT_FOUND_MESSAGE "Isoduo requires Windows x64 and an MSVC ABI compiler")
    return()
  endif()
  @ISODUO_TOOLSET_DETECTOR@
  isoduo_detect_msvc_toolset(_isoduo_consumer_toolset)
  if(Isoduo_MSVC_TOOLSET_VERSION AND _isoduo_consumer_toolset AND _isoduo_consumer_toolset VERSION_LESS Isoduo_MSVC_TOOLSET_VERSION)
    message(WARNING "Isoduo consumer MSVC toolset ${_isoduo_consumer_toolset} is older than the Isoduo build toolset ${Isoduo_MSVC_TOOLSET_VERSION}; use an equal or newer toolset")
  elseif(NOT Isoduo_MSVC_TOOLSET_VERSION OR NOT _isoduo_consumer_toolset)
    message(WARNING "Isoduo could not compare MSVC toolsets (consumer: '${_isoduo_consumer_toolset}', Isoduo build: '${Isoduo_MSVC_TOOLSET_VERSION}'); verify that the consumer toolset is not older")
  endif()
  unset(_isoduo_consumer_toolset)
  if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL Isoduo_MSVC_RUNTIME_LIBRARY)
    set(Isoduo_FOUND FALSE)
    set(Isoduo_NOT_FOUND_MESSAGE "MSVC runtime mismatch: consumer ${CMAKE_MSVC_RUNTIME_LIBRARY}, Isoduo ${Isoduo_MSVC_RUNTIME_LIBRARY}; rebuild Isoduo with the same setting")
    return()
  endif()
endif()
get_property(_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(NOT _multi AND NOT CMAKE_BUILD_TYPE)
  set(Isoduo_FOUND FALSE)
  set(Isoduo_NOT_FOUND_MESSAGE "Please specify -DCMAKE_BUILD_TYPE=Debug or Release")
  return()
endif()
# Core is available even when every requested optional component is unavailable.
if(NOT TARGET Isoduo::Core)
  include("${CMAKE_CURRENT_LIST_DIR}/IsoduoCoreTargets.cmake")
endif()
set(Isoduo_Core_FOUND TRUE)
set_target_properties(Isoduo::Core PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release MAP_IMPORTED_CONFIG_MINSIZEREL Release)
set(_available Core AppearanceWeb AppearanceMaterial Desktop Diagnostics)
foreach(_component IN LISTS Isoduo_FIND_COMPONENTS)
  if(_component STREQUAL "Core")
    continue()
  endif()
  if(NOT _component IN_LIST _available)
    set(Isoduo_${_component}_FOUND FALSE)
    if(Isoduo_FIND_REQUIRED_${_component})
      set(Isoduo_NOT_FOUND_MESSAGE "Unknown Isoduo component ${_component}; available: ${_available}")
    endif()
  elseif(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/Isoduo${_component}Targets.cmake")
    set(Isoduo_${_component}_FOUND FALSE)
    if(Isoduo_FIND_REQUIRED_${_component})
      set(Isoduo_NOT_FOUND_MESSAGE "Isoduo was built with ISODUO_BUILD_DESKTOP=OFF; ${_component} is unavailable")
    endif()
  else()
    if(_component STREQUAL "Desktop" AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT TARGET Isoduo::Desktop)
      # A missing desktop dependency only makes the Desktop component unavailable.
      find_package(PkgConfig QUIET)
      find_package(Fontconfig QUIET)
      find_package(Threads QUIET)
      if(PkgConfig_FOUND AND NOT TARGET PkgConfig::ISODUO_LINUX_DESKTOP)
        pkg_check_modules(ISODUO_LINUX_DESKTOP QUIET IMPORTED_TARGET GLOBAL egl>=1.5 x11 x11-xcb xcb wayland-client>=1.22 wayland-egl xkbcommon gio-2.0 pango)
      endif()
      if(NOT TARGET Fontconfig::Fontconfig OR NOT TARGET Threads::Threads OR NOT TARGET PkgConfig::ISODUO_LINUX_DESKTOP)
        set(Isoduo_Desktop_FOUND FALSE)
        if(Isoduo_FIND_REQUIRED_Desktop)
          set(Isoduo_NOT_FOUND_MESSAGE "Isoduo Desktop requires Fontconfig, Threads, and the EGL, X11, Wayland, xkbcommon, GIO and Pango development packages")
        endif()
        continue()
      endif()
    endif()
    if(NOT TARGET Isoduo::${_component})
      include("${CMAKE_CURRENT_LIST_DIR}/Isoduo${_component}Targets.cmake")
    endif()
    set(Isoduo_${_component}_FOUND TRUE)
    set_target_properties(Isoduo::${_component} PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release MAP_IMPORTED_CONFIG_MINSIZEREL Release)
  endif()
endforeach()
if(TARGET Isoduo::Desktop)
  foreach(_internal internal_render internal_freetype internal_harfbuzz)
    set_target_properties(Isoduo::${_internal} PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release MAP_IMPORTED_CONFIG_MINSIZEREL Release)
  endforeach()
endif()
check_required_components(Isoduo)
if(Isoduo_FOUND)
  message(STATUS "Found Isoduo ${Isoduo_VERSION} from ${CMAKE_CURRENT_LIST_DIR}")
endif()

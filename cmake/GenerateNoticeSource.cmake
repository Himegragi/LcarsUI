# Embed the exact sections of the shipped notice in static UTF-16 literals.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.txt")
file(READ "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.txt" notice_text)
set(separator "========================================================================\n")
string(FIND "${notice_text}" "${separator}" start)
if(start EQUAL -1)
  message(FATAL_ERROR "Missing notice sections")
endif()
string(LENGTH "${separator}" separator_length)
math(EXPR start "${start} + ${separator_length}")
string(SUBSTRING "${notice_text}" ${start} -1 remaining)
foreach(index RANGE 0 2)
  string(FIND "${remaining}" "${separator}" end)
  if(index LESS 2 AND end EQUAL -1)
    message(FATAL_ERROR "Missing notice section ${index}")
  endif()
  if(end EQUAL -1)
    set(section "${remaining}")
  else()
    string(SUBSTRING "${remaining}" 0 ${end} section)
    math(EXPR next "${end} + ${separator_length}")
    string(SUBSTRING "${remaining}" ${next} -1 remaining)
  endif()
  string(FIND "${section}" ")LCARS_NOTICE\"" collision)
  if(NOT collision EQUAL -1)
    message(FATAL_ERROR "Notice contains C++ raw string delimiter")
  endif()
  # Keep each token below MSVC's string literal limit; adjacent literals form
  # one static array without allocating at runtime.
  set(literals "")
  string(LENGTH "${section}" remaining_length)
  while(remaining_length GREATER 0)
    if(remaining_length GREATER 1000)
      string(SUBSTRING "${section}" 1000 -1 tail)
      string(FIND "${tail}" "\n" newline)
      if(newline EQUAL -1 OR newline GREATER 3000)
        message(FATAL_ERROR "Notice line too long to embed safely")
      endif()
      math(EXPR chunk_length "1000 + ${newline} + 1")
    else()
      set(chunk_length ${remaining_length})
    endif()
    string(SUBSTRING "${section}" 0 ${chunk_length} chunk)
    string(SUBSTRING "${section}" ${chunk_length} -1 section)
    string(APPEND literals "uR\"LCARS_NOTICE(${chunk})LCARS_NOTICE\"\n")
    string(LENGTH "${section}" remaining_length)
  endwhile()
  set(section_${index} "${literals}")
endforeach()
file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/generated/third_party_notices.cpp" CONTENT "#include <lcars/third_party_notices.hpp>\nnamespace lcars {\nnamespace {\nconst ThirdPartyNotice notices[] = {\n{u\"FreeType\", u\"${freetype_VERSION}\", u\"FreeType License (FTL)\", u\"${freetype_URL}\", ${section_0}},\n{u\"HarfBuzz\", u\"${harfbuzz_VERSION}\", u\"Old MIT\", u\"${harfbuzz_URL}\", ${section_1}},\n{u\"Khronos OpenGL headers\", u\"${glcorearb_COMMIT}\", u\"MIT\", u\"${glcorearb_URL}\", ${section_2}}\n};\n}\nstd::span<const ThirdPartyNotice> third_party_notices() noexcept { return notices; }\n}\n")

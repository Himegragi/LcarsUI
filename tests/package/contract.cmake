set(prefix "${BUILD_DIR}/package-prefix")
set(work "${BUILD_DIR}/package-contract")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/src")
function(run_case name package expect_success)
  file(WRITE "${work}/src/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)\nproject(Contract LANGUAGES CXX)\n${package}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}/src" -B "${work}/${name}" -G "${GENERATOR}"
    "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF" "-DCMAKE_BUILD_TYPE=${BUILD_TYPE}"
    "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expect_success AND result)
    message(FATAL_ERROR "${name} failed: ${output} ${error}")
  elseif(NOT expect_success AND NOT result)
    message(FATAL_ERROR "${name} unexpectedly succeeded")
  endif()
  if(name STREQUAL "unknown" AND NOT "${output}${error}" MATCHES "Widgets.*available")
    message(FATAL_ERROR "Missing unknown component diagnostic: ${output} ${error}")
  endif()
endfunction()
run_case(unknown "find_package(LcarsUI REQUIRED COMPONENTS Widgets)" FALSE)
run_case(optional "find_package(LcarsUI REQUIRED OPTIONAL_COMPONENTS Widgets)\nif(LcarsUI_Widgets_FOUND)\n message(FATAL_ERROR unexpected)\nendif()" TRUE)
run_case(old "find_package(LcarsUI 0.1 REQUIRED)" FALSE)
run_case(future "find_package(LcarsUI 1.0 REQUIRED)" FALSE)
run_case(previous "find_package(LcarsUI 0.2 REQUIRED)" FALSE)
run_case(current "find_package(LcarsUI 0.3 REQUIRED)" TRUE)
foreach(header IN ITEMS appearance core layout version)
  file(READ "${prefix}/include/lcars/${header}.hpp" content HEX)
  string(REGEX REPLACE "[0-7][0-9a-f]" "" non_ascii "${content}")
  if(non_ascii)
    message(FATAL_ERROR "Non-ASCII header: ${header}")
  endif()
  file(WRITE "${work}/src/${header}.cpp" "#include <lcars/${header}.hpp>\n")
endforeach()
file(WRITE "${work}/src/standard.cpp" "#if _MSVC_LANG < REQUIRED_LANG\n#error standard too old\n#endif\n")
file(WRITE "${work}/src/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)\nproject(Headers LANGUAGES CXX)\nfind_package(LcarsUI REQUIRED COMPONENTS Core)\nadd_library(headers OBJECT appearance.cpp core.cpp layout.cpp version.cpp standard.cpp)\ntarget_compile_definitions(headers PRIVATE REQUIRED_LANG=\${REQUIRED_LANG})\ntarget_link_libraries(headers PRIVATE LcarsUI::Core)\n")
foreach(std IN ITEMS 17 23)
  if(std EQUAL 17)
    set(required_lang 202002L)
  else()
    set(required_lang 202003L)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}/src" -B "${work}/std${std}" -G "${GENERATOR}" "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_BUILD_TYPE=${BUILD_TYPE}" "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}" "-DCMAKE_CXX_STANDARD=${std}" "-DREQUIRED_LANG=${required_lang}" RESULT_VARIABLE result)
  if(result)
    message(FATAL_ERROR "Configure std ${std} failed")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/std${std}" --config "${BUILD_TYPE}" RESULT_VARIABLE result)
  if(result)
    message(FATAL_ERROR "Build std ${std} failed")
  endif()
endforeach()


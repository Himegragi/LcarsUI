file(GLOB_RECURSE headers "${PREFIX}/include/*")
list(APPEND headers "${PREFIX}/share/doc/LcarsUI/THIRD_PARTY_NOTICES.txt")
foreach(path IN LISTS headers)
  if(NOT IS_DIRECTORY "${path}")
    file(READ "${path}" contents)
    string(TOLOWER "${contents}" contents)
    if(contents MATCHES "nlohmann")
      message(FATAL_ERROR "Example-only JSON license leaked into ${path}")
    endif()
  endif()
endforeach()

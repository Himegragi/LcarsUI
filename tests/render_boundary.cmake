file(GLOB_RECURSE sources "${SOURCE_DIR}/src/*.cpp" "${SOURCE_DIR}/src/*.hpp")
foreach(path IN LISTS sources)
  if(path MATCHES "renderer_opengl\\.(cpp|hpp)$")
    continue()
  endif()
  file(READ "${path}" content)
  if(content MATCHES "(^|[^A-Za-z0-9_])(gl[A-Z][A-Za-z0-9_]*|GL_[A-Z0-9_]+|wgl[A-Z][A-Za-z0-9_]*|GLuint|HGLRC|OpenGL)([^A-Za-z0-9_]|$)" OR content MATCHES "height[ \t]*-[ \t]*1[ \t]*-")
    message(FATAL_ERROR "Backend-specific assumption in ${path}")
  endif()
endforeach()

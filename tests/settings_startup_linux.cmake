file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/settings-startup")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/settings-startup/${suffix}")
file(MAKE_DIRECTORY "${root}")

function(expectFailure message)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY --unset=XDG_RUNTIME_DIR
      XDG_SESSION_TYPE=x11 "XDG_CONFIG_HOME=${config}" "HOME=${root}/home" "${DEMO}" ${ARGN}
    WORKING_DIRECTORY "${root}" RESULT_VARIABLE status ERROR_VARIABLE error TIMEOUT 10)
  if(NOT status STREQUAL "1" OR NOT error MATCHES "${message}")
    file(REMOVE_RECURSE "${root}")
    message(FATAL_ERROR "Expected exit 1 and '${message}', got '${status}' and '${error}'")
  endif()
endfunction()

function(expectQuarantine directory)
  file(MAKE_DIRECTORY "${directory}")
  file(WRITE "${directory}/settings.json" "broken settings")
  expectFailure("Desktop startup failed" ${ARGN})
  file(READ "${directory}/settings.json.bad" original)
  if(EXISTS "${directory}/settings.json" OR NOT original STREQUAL "broken settings")
    file(REMOVE_RECURSE "${root}")
    message(FATAL_ERROR "Selected directory did not preserve the broken file: ${directory}")
  endif()
endfunction()

set(config "${root}/XDG 設定")
expectQuarantine("${config}/Isoduo/SettingsDemo")
expectQuarantine("${root}/獨立 設定" --settings-dir "獨立 設定")
set(config "")
expectQuarantine("${root}/home/.config/Isoduo/SettingsDemo")
set(config "relative-config")
expectQuarantine("${root}/home/.config/Isoduo/SettingsDemo")
expectFailure("Usage:" --unknown value)
expectFailure("Usage:" --settings-dir)
expectFailure("Usage:" --settings-dir "")
expectFailure("Usage:" --settings-dir --diagnostics-out)
expectFailure("Usage:" --settings-dir first --settings-dir second)
expectFailure("--diagnostics-out needs a build with Isoduo::Diagnostics" --diagnostics-out "unused.json")
file(REMOVE_RECURSE "${root}")
